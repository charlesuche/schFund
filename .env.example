# Copy to .env and fill in. Never commit .env.
# Host port for the Docker database. Change it (here and in both URLs below)
# if another PostgreSQL already uses 5432 on your computer.
DB_PORT=5432
DATABASE_URL=postgresql://scholar:scholar@localhost:5432/scholarships
# Separate database for pytest. The loader tests drop and recreate tables here.
TEST_DATABASE_URL=postgresql://scholar:scholar@localhost:5432/scholarships_test
# LLM_API_KEY=

# --- Only needed on the server (Render), or locally to test the report form ---
# Public address, no trailing slash. Used for canonical links and the sitemap.
# SITE_URL=https://yourdomain.org
# Email for "Report a problem" (Brevo SMTP; any SMTP service works).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@yourdomain.org
# REPORT_TO=you@example.com
# Shown on the Privacy page for data requests.
# CONTACT_EMAIL=privacy@yourdomain.org
